rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'awoyinfasolomon1@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function safeSelfProfileCreate(userId) {
      return isSelf(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'licenseKey',
          'licensePlan',
          'licenseStatus',
          'licenseExpiresAt',
          'hasUsedTrial',
          'createdAt',
          'lastLogin'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.licenseKey == null
        && request.resource.data.licensePlan == 'New User (No Key)'
        && request.resource.data.licenseStatus == 'expired'
        && request.resource.data.licenseExpiresAt == null
        && request.resource.data.hasUsedTrial == false;
    }

    match /users/{userId} {
      allow get: if isOwner() || isSelf(userId);
      allow list: if isOwner();
      allow create: if isOwner() || safeSelfProfileCreate(userId);
      allow update: if isOwner()
        || (
          isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastLogin', 'displayName', 'photoURL'])
          && request.resource.data.email == resource.data.email
        );
      allow delete: if isOwner();
    }

    match /user_licenses/{userId} {
      allow get: if isOwner() || isSelf(userId);
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }

    match /licenses/{licenseId} {
      allow read, write: if isOwner();
    }

    match /claimed_trials/{trialId} {
      allow read, write: if isOwner();
    }

    match /user_settings/{userId} {
      allow read, write: if isOwner() || isSelf(userId);
    }

    match /group_security/{documentId} {
      allow read, write: if isOwner();
    }

    match /group_warnings/{documentId} {
      allow read, write: if isOwner();
    }

    match /bot_settings/{documentId} {
      allow read, write: if isOwner();
    }

    // WhatsApp session documents and their nested auth files contain credentials.
    match /whatsapp_sessions/{documentId} {
      allow read, write: if false;
      match /auth_files/{fileId} {
        allow read, write: if false;
      }
    }

    // Deny every collection that is not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
